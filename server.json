{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.optimesh-ai/rulehawk",
  "title": "RuleHawk",
  "description": "Local, read-only firewall/ACL rule audit: shadowed, risky and over-permissive rules, before/after.",
  "version": "0.4.0",
  "websiteUrl": "https://github.com/optimesh-ai/RuleHawk",
  "repository": {
    "url": "https://github.com/optimesh-ai/RuleHawk",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "rulehawk",
      "version": "0.4.0",
      "runtimeHint": "uvx",
      "runtimeArguments": [
        {
          "type": "named",
          "name": "--from",
          "value": "rulehawk[mcp]==0.4.0"
        }
      ],
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "RULEHAWK_MCP_ROOT",
          "description": "Optional. Refuse any config path outside this directory.",
          "isRequired": false,
          "isSecret": false
        }
      ],
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
