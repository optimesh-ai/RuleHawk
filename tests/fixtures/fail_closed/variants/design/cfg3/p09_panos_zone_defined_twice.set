set network interface ethernet ethernet1/1 layer3 ip 192.0.2.1/24
set network interface ethernet ethernet1/2 layer3 ip 198.51.100.1/24
set zone corp network layer3 [ ethernet1/1 ]
set zone pci network layer3 [ ethernet1/2 ]
set zone corp network layer3 [ ethernet1/2 ]
set rulebase security rules d from corp to pci source any destination any application any service any action deny
set rulebase security rules z from any to any source any destination any application any service any action allow
