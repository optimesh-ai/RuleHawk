set address CORP ip-netmask 192.0.2.0/24
set address OTH ip-netmask 203.0.113.0/24
set address-group G static [ CORP ]
set address-group G static [ OTH ]
set rulebase security rules d from any to any source G destination 198.51.100.0/24 application any service any action deny
set rulebase security rules a from any to any source any destination any application any service any action allow
