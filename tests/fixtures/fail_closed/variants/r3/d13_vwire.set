set network virtual-wire vw1 interface1 ethernet1/3 interface2 ethernet1/4
set network virtual-wire vw1 tag-allowed 0-4094
set rulebase security rules d from any to any source 192.0.2.0/24 destination 198.51.100.0/24 application any service any action deny
set rulebase security rules a from any to any source 192.0.2.0/24 destination any application any service any action allow
